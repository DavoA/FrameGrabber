<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/cPrimary" android:endColor="?attr/cPrimaryBright" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/cSurface2" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="?attr/h665CF5AE" />
        </shape>
    </item>
</selector>
