<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/primary" android:endColor="@color/primaryBright" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#665CF5AE" />
        </shape>
    </item>
</selector>
