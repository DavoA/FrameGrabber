<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="@color/cyan" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="@color/primaryBright" android:endColor="@color/primary" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
