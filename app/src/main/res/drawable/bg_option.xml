<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#335CF5AE">
    <item>
        <selector android:enterFadeDuration="200" android:exitFadeDuration="200">
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#331A8A50" />
                    <corners android:radius="16dp" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF0C2218" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="@color/stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
