<?xml version="1.0" encoding="utf-8"?>
<!-- ⚙ → Хэштеги: the library by category -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cBg">

    <com.dave.framegrabber.ui.widget.SynthwaveView
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">
            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="Назад"
                android:src="@drawable/ic_arrow_back" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Хэштеги"
                    android:textColor="?attr/cText"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/txtSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/cTextDim"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/IconBtn"
                android:contentDescription="Ещё"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <EditText
            android:id="@+id/editSearch"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:hint="🔍 Поиск по всем тегам"
            android:imeOptions="actionSearch"
            android:inputType="text|textNoSuggestions" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:id="@+id/catsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnAddCat"
            style="@style/BtnSecondary"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:text="＋ Новая категория" />
    </LinearLayout>
</FrameLayout>
