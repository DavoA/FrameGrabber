<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Инструменты»: range, batch, GIF / clip / contact sheet. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageTools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <include
            android:id="@+id/rangeBatch"
            layout="@layout/range_card" />


        <!-- ===== Batch panel ===== -->
        <LinearLayout
            android:id="@+id/cardBatch"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="🎞  Пачка кадров" />

            <RadioGroup
                android:id="@+id/radioBatch"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/batchInterval" style="@style/Segment" android:checked="true" android:text="Каждые N сек" />
                <RadioButton android:id="@+id/batchCount" style="@style/Segment" android:text="Количество" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp">
                <TextView
                    android:id="@+id/lblBatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Интервал, сек"
                    android:textColor="@color/text" />
                <EditText
                    android:id="@+id/editBatch"
                    style="@style/Input"
                    android:layout_width="110dp"
                    android:inputType="numberDecimal"
                    android:text="5" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSkipBlur"
                style="@style/Toggle"
                android:layout_marginTop="8dp"
                android:text="Пропускать размытые кадры" />
            <Switch
                android:id="@+id/swSkipDup"
                style="@style/Toggle"
                android:text="Пропускать повторы (одинаковые кадры)" />

            <TextView
                android:id="@+id/txtBatchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBatch"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_burst"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Снять пачку кадров" />

            <ProgressBar
                android:id="@+id/progressBatch"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== Export panel ===== -->

        <!-- ===== Contact sheet (from the captured frames) ===== -->
        <LinearLayout
            android:id="@+id/cardSheet"
            style="@style/Card"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="▦  Лист кадров" />
            
            <TextView
                style="@style/SubHint"
                android:text="Все снятые кадры одной картинкой, с временем под каждым." />
            <Button
                android:id="@+id/btnSheet"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_grid"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Собрать лист кадров" />
            <ProgressBar
                android:id="@+id/progressExport"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
