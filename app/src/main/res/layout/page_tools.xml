<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Инструменты»: range, batch, GIF / clip / contact sheet. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageTools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <!-- ===== Split into parts (for Telegram's 2 GB limit) ===== -->
        <LinearLayout
            android:id="@+id/cardSplit"
            style="@style/Card">
            <TextView
                style="@style/CardTitle"
                android:text="✂  Разделить на части" />
            <TextView
                android:id="@+id/txtSplitInfo"
                style="@style/SubHint"
                android:text="Сначала выбери видео" />

            <TextView style="@style/Label" android:text="Максимум на одну часть" />
            <RadioGroup
                android:id="@+id/radioSplitLimit"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/sl2" style="@style/Segment" android:checked="true" android:text="2 ГБ" />
                <RadioButton android:id="@+id/sl4" style="@style/Segment" android:text="4 ГБ Premium" />
                <RadioButton android:id="@+id/slCustom" style="@style/Segment" android:text="Своё" />
            </RadioGroup>
            <LinearLayout
                android:id="@+id/rowSplitCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <EditText
                    android:id="@+id/editSplitMb"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="например 1000"
                    android:inputType="number" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="МБ"
                    android:textColor="?attr/cTextDim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="Количество частей" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnSplitMinus"
                    style="@style/BtnSecondary"
                    android:layout_width="52dp"
                    android:text="−"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/txtSplitCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="?attr/cText"
                    android:textSize="17sp" />
                <Button
                    android:id="@+id/btnSplitPlus"
                    style="@style/BtnSecondary"
                    android:layout_width="52dp"
                    android:text="＋"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- each part: time and size -->
            <LinearLayout
                android:id="@+id/splitParts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/txtSplitHint"
                style="@style/SubHint"
                android:paddingTop="6dp" />

            <ProgressBar
                android:id="@+id/progressSplit"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:progressBackgroundTint="?attr/cStroke"
                android:progressTint="?attr/cAccent"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnSplit"
                style="@style/BtnPrimary"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_split"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Разделить" />
        </LinearLayout>

        <include
            android:id="@+id/rangeBatch"
            layout="@layout/range_card" />


        <!-- ===== Batch panel ===== -->
        <LinearLayout
            android:id="@+id/cardBatch"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="🎞  Пачка кадров" />

            <RadioGroup
                android:id="@+id/radioBatch"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/batchInterval" style="@style/Segment" android:checked="true" android:text="Каждые N сек" />
                <RadioButton android:id="@+id/batchCount" style="@style/Segment" android:text="Количество" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp">
                <TextView
                    android:id="@+id/lblBatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Интервал, сек"
                    android:textColor="?attr/cText" />
                <EditText
                    android:id="@+id/editBatch"
                    style="@style/Input"
                    android:layout_width="110dp"
                    android:inputType="numberDecimal"
                    android:text="5" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSkipBlur"
                style="@style/Toggle"
                android:layout_marginTop="8dp"
                android:text="Пропускать размытые кадры" />
            <Switch
                android:id="@+id/swSkipDup"
                style="@style/Toggle"
                android:text="Пропускать повторы (одинаковые кадры)" />

            <TextView
                android:id="@+id/txtBatchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="?attr/cTextDim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBatch"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_burst"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Снять пачку кадров" />

            <!-- the same settings over several videos at once -->
            <Button
                android:id="@+id/btnBatchMulti"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:minHeight="52dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_video_library"
                android:drawableTint="?attr/cAccent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Несколько видео сразу…" />

            <ProgressBar
                android:id="@+id/progressBatch"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progressBackgroundTint="?attr/cStroke"
                android:progressTint="?attr/cAccent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="?attr/cTextDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== Export panel ===== -->

        <!-- ===== Contact sheet (from the captured frames) ===== -->
        <LinearLayout
            android:id="@+id/cardSheet"
            style="@style/Card"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="▦  Лист кадров" />
            
            <TextView
                style="@style/SubHint"
                android:text="Все снятые кадры одной картинкой, с временем под каждым." />
            <Button
                android:id="@+id/btnSheet"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_grid"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Собрать лист кадров" />
            <ProgressBar
                android:id="@+id/progressExport"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="?attr/cStroke"
                android:progressTint="?attr/cAccent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="?attr/cTextDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
