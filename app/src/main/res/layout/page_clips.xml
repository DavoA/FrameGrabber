<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Клипы»: GIF and MP4 clips from a range, and the ones already made. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageClips"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <include
            android:id="@+id/rangeClips"
            layout="@layout/range_card" />

        <LinearLayout
            android:id="@+id/cardGif"
            style="@style/Card">
            <TextView
                style="@style/CardTitle"
                android:text="GIF" />
            
            <TextView style="@style/Label" android:paddingTop="0dp" android:text="Плавность (кадров в секунду)" />
            <RadioGroup
                android:id="@+id/radioGifFps"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/fps10" style="@style/Segment" android:text="10" />
                <RadioButton android:id="@+id/fps15" style="@style/Segment" android:checked="true" android:text="15" />
                <RadioButton android:id="@+id/fps20" style="@style/Segment" android:text="20" />
                <RadioButton android:id="@+id/fps25" style="@style/Segment" android:text="25" />
                <RadioButton android:id="@+id/fps30" style="@style/Segment" android:text="30" />
            </RadioGroup>

            <TextView style="@style/Label" android:text="Размер (ширина)" />
            <RadioGroup
                android:id="@+id/radioGifW"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/gw320" style="@style/Segment" android:text="320" />
                <RadioButton android:id="@+id/gw480" style="@style/Segment" android:checked="true" android:text="480" />
                <RadioButton android:id="@+id/gw720" style="@style/Segment" android:text="720" />
                <RadioButton android:id="@+id/gw1080" style="@style/Segment" android:text="1080" />
                <RadioButton android:id="@+id/gwOrig" style="@style/Segment" android:text="Ориг." />
            </RadioGroup>

            <TextView style="@style/Label" android:text="Качество цвета" />
            <RadioGroup
                android:id="@+id/radioGifQ"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/gqNormal" style="@style/Segment" android:text="Обычное" />
                <RadioButton android:id="@+id/gqHigh" style="@style/Segment" android:checked="true" android:text="Высокое" />
                <RadioButton android:id="@+id/gqMax" style="@style/Segment" android:text="Максимум" />
            </RadioGroup>
            <TextView
                android:id="@+id/txtGifQHint"
                style="@style/SubHint"
                android:paddingTop="6dp" />

            <TextView style="@style/Label" android:text="Скорость" />
            <RadioGroup
                android:id="@+id/radioGifSpeed"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/gs05" style="@style/Segment" android:text="0.5×" />
                <RadioButton android:id="@+id/gs1" style="@style/Segment" android:checked="true" android:text="1×" />
                <RadioButton android:id="@+id/gs2" style="@style/Segment" android:text="2×" />
            </RadioGroup>

            <Switch
                android:id="@+id/swBoomerang"
                style="@style/Toggle"
                android:layout_marginTop="8dp"
                android:text="Бумеранг (вперёд и обратно)" />

            <TextView
                android:id="@+id/txtGifInfo"
                style="@style/SubHint"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="10dp" />

            <Button
                android:id="@+id/btnGif"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_gif"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Сделать GIF" />
            <ProgressBar
                android:id="@+id/progressGif"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="?attr/cStroke"
                android:progressTint="?attr/cAccent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtGif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="?attr/cTextDim"
                android:textSize="13sp"
                android:visibility="gone" />

            
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardClip"
            style="@style/Card">
            <TextView
                style="@style/CardTitle"
                android:text="Видео-клип" />
            <TextView
                style="@style/SubHint"
                android:text="MP4 со звуком, без потери качества. Начало сдвигается к ближайшему ключевому кадру." />
            <Button
                android:id="@+id/btnClip"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_cut"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Вырезать клип" />
            <ProgressBar
                android:id="@+id/progressClips"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="?attr/cStroke"
                android:progressTint="?attr/cAccent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtClips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="?attr/cTextDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Made so far -->
        <LinearLayout
            android:id="@+id/cardMade"
            style="@style/Card"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingBottom="0dp"
                    android:text="Готовые" />
                <ImageButton
                    android:id="@+id/btnMadeView"
                    style="@style/IconBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Список / сетка"
                    android:src="@drawable/ic_grid" />
                <TextView
                    android:id="@+id/txtMadeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_count"
                    android:gravity="center"
                    android:minWidth="28dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/txtMadeEmpty"
                style="@style/SubHint"
                android:paddingTop="12dp"
                android:gravity="center"
                android:text="Здесь появятся GIF и клипы, которые ты сделаешь" />
            <LinearLayout
                android:id="@+id/madeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
