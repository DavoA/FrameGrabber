<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolling part (ListView header). The captures grid rows follow it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- ===== Recently opened videos (start screen) ===== -->
    <LinearLayout
        android:id="@+id/cardRecent"
        style="@style/Card"
        android:layout_marginTop="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_history"
                android:tint="@color/accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="Недавние видео"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/recentRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ===== Timeline: filmstrip with the seek bar laid over it ===== -->
    <LinearLayout
        android:id="@+id/cardTimeline"
        style="@style/Card"
        android:layout_marginTop="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Таймлайн"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/timelineBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_filmstrip">

            <LinearLayout
                android:id="@+id/filmstrip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progressDrawable="@drawable/seek_overlay"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb_bar"
                android:thumbOffset="3dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Range used by batch AND export ===== -->
    <LinearLayout
        android:id="@+id/cardRange"
        style="@style/Card"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отрезок"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtRangeLen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="всё видео"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <ImageButton
                android:id="@+id/btnMarkIn"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Начало = текущий кадр"
                android:src="@drawable/ic_mark_in" />
            <EditText
                android:id="@+id/editFrom"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:hint="0:00"
                android:inputType="text"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="—"
                android:textColor="@color/textDim" />
            <EditText
                android:id="@+id/editTo"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="monospace"
                android:hint="конец"
                android:inputType="text"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/btnMarkOut"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Конец = текущий кадр"
                android:src="@drawable/ic_mark_out" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Tabs ===== -->
    <RadioGroup
        android:id="@+id/radioTabs"
        style="@style/SegmentGroup"
        android:layout_marginTop="14dp">
        <RadioButton
            android:id="@+id/tabBatch"
            style="@style/Segment"
            android:checked="true"
            android:text="Пачка" />
        <RadioButton
            android:id="@+id/tabExport"
            style="@style/Segment"
            android:text="Экспорт" />
        <RadioButton
            android:id="@+id/tabSettings"
            style="@style/Segment"
            android:text="Формат" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/panelHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== Batch panel ===== -->
        <LinearLayout
            android:id="@+id/cardBatch"
            style="@style/Card"
            android:layout_marginTop="10dp">

            <RadioGroup
                android:id="@+id/radioBatch"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/batchInterval" style="@style/Segment" android:checked="true" android:text="Каждые N сек" />
                <RadioButton android:id="@+id/batchCount" style="@style/Segment" android:text="Количество" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp">
                <TextView
                    android:id="@+id/lblBatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Интервал, сек"
                    android:textColor="@color/text" />
                <EditText
                    android:id="@+id/editBatch"
                    style="@style/Input"
                    android:layout_width="110dp"
                    android:inputType="numberDecimal"
                    android:text="5" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSkipBlur"
                style="@style/Toggle"
                android:layout_marginTop="8dp"
                android:text="Пропускать размытые кадры" />
            <Switch
                android:id="@+id/swSkipDup"
                style="@style/Toggle"
                android:text="Пропускать повторы (одинаковые кадры)" />

            <TextView
                android:id="@+id/txtBatchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBatch"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_burst"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Снять пачку кадров" />

            <ProgressBar
                android:id="@+id/progressBatch"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== Export panel ===== -->
        <LinearLayout
            android:id="@+id/cardExport"
            style="@style/Card"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView style="@style/Label" android:paddingTop="0dp" android:text="GIF из отрезка" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioGroup
                    android:id="@+id/radioGifFps"
                    style="@style/SegmentGroup"
                    android:layout_width="0dp"
                    android:layout_weight="1">
                    <RadioButton android:id="@+id/fps5" style="@style/Segment" android:text="5 к/с" />
                    <RadioButton android:id="@+id/fps10" style="@style/Segment" android:checked="true" android:text="10" />
                    <RadioButton android:id="@+id/fps15" style="@style/Segment" android:text="15" />
                </RadioGroup>
                <RadioGroup
                    android:id="@+id/radioGifW"
                    style="@style/SegmentGroup"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <RadioButton android:id="@+id/gw320" style="@style/Segment" android:text="320" />
                    <RadioButton android:id="@+id/gw480" style="@style/Segment" android:checked="true" android:text="480" />
                    <RadioButton android:id="@+id/gw720" style="@style/Segment" android:text="720" />
                </RadioGroup>
            </LinearLayout>
            <Button
                android:id="@+id/btnGif"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_gif"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Сделать GIF" />

            <TextView style="@style/Label" android:text="Видео-клип" />
            <TextView
                style="@style/SubHint"
                android:text="MP4 со звуком, без потери качества. Начало сдвигается к ближайшему ключевому кадру." />
            <Button
                android:id="@+id/btnClip"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_cut"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Вырезать клип" />

            <TextView style="@style/Label" android:text="Лист кадров" />
            <TextView
                style="@style/SubHint"
                android:text="Все снятые кадры одной картинкой, с временем под каждым." />
            <Button
                android:id="@+id/btnSheet"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_grid"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Собрать лист кадров" />

            <ProgressBar
                android:id="@+id/progressExport"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== Output settings panel ===== -->
        <LinearLayout
            android:id="@+id/cardSettings"
            style="@style/Card"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:paddingTop="0dp"
                android:text="Размер" />

            <RadioGroup
                android:id="@+id/radioSize"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/sizeOrig" style="@style/Segment" android:checked="true" android:text="Оригинал" />
                <RadioButton android:id="@+id/size720" style="@style/Segment" android:text="720p" />
                <RadioButton android:id="@+id/size1080" style="@style/Segment" android:text="1080p" />
                <RadioButton android:id="@+id/sizeCustom" style="@style/Segment" android:text="Свой" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/customSizeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:visibility="gone">
                <EditText
                    android:id="@+id/editW"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Ширина"
                    android:inputType="number"
                    android:text="1920" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="×"
                    android:textColor="@color/textDim" />
                <EditText
                    android:id="@+id/editH"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Высота"
                    android:inputType="number"
                    android:text="1080" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="Формат" />

            <RadioGroup
                android:id="@+id/radioFormat"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/fmtJpg" style="@style/Segment" android:checked="true" android:text="JPG" />
                <RadioButton android:id="@+id/fmtPng" style="@style/Segment" android:text="PNG" />
                <RadioButton android:id="@+id/fmtWebp" style="@style/Segment" android:text="WebP" />
            </RadioGroup>

            <TextView
                android:id="@+id/txtQuality"
                style="@style/Label"
                android:text="Качество: 92" />

            <SeekBar
                android:id="@+id/seekQuality"
                style="@style/Slider"
                android:paddingTop="4dp"
                android:max="100"
                android:progress="92" />

            <TextView style="@style/Label" android:text="Умная съёмка" />
            <Switch
                android:id="@+id/swSharpest"
                style="@style/Toggle"
                android:checked="true"
                android:text="Самый резкий кадр рядом (±0,5 с)" />
            <TextView
                style="@style/SubHint"
                android:text="Проверяет соседние кадры и сохраняет наименее смазанный. Помогает при движении." />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Captures section ===== -->
    <LinearLayout
        android:id="@+id/capHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="22dp"
        android:paddingBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Снятые кадры"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_count"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/txtTapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="нажми, чтобы открыть"
            android:textColor="@color/textDim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnSaveAll"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_gallery"
            android:text="Галерея" />
        <Button
            android:id="@+id/btnZip"
            style="@style/ToolBtn"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_archive"
            android:text="ZIP" />
        <Button
            android:id="@+id/btnClear"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_sweep"
            android:drawableTint="@color/danger"
            android:text="Очистить"
            android:textColor="@color/danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="30dp">
        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.6"
            android:src="@drawable/ic_photo"
            android:tint="@color/textDim" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:gravity="center"
            android:text="Пока пусто\nСними кадр кнопкой с камерой или пачку выше"
            android:textColor="@color/textDim"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
