<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolling part (ListView header). The captures grid rows follow it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- ===== Timeline: filmstrip with the seek bar laid over it ===== -->
    <LinearLayout
        android:id="@+id/cardTimeline"
        style="@style/Card"
        android:layout_marginTop="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Таймлайн"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/timelineBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_filmstrip">

            <LinearLayout
                android:id="@+id/filmstrip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progressDrawable="@drawable/seek_overlay"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb_bar"
                android:thumbOffset="3dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Tabs ===== -->
    <RadioGroup
        android:id="@+id/radioTabs"
        style="@style/SegmentGroup"
        android:layout_marginTop="14dp">
        <RadioButton
            android:id="@+id/tabBatch"
            style="@style/Segment"
            android:checked="true"
            android:text="Пачка кадров" />
        <RadioButton
            android:id="@+id/tabSettings"
            style="@style/Segment"
            android:text="Формат и размер" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/panelHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== Batch panel ===== -->
        <LinearLayout
            android:id="@+id/cardBatch"
            style="@style/Card"
            android:layout_marginTop="10dp">

            <RadioGroup
                android:id="@+id/radioBatch"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/batchInterval" style="@style/Segment" android:checked="true" android:text="Каждые N сек" />
                <RadioButton android:id="@+id/batchCount" style="@style/Segment" android:text="Количество" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp">
                <TextView
                    android:id="@+id/lblBatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Интервал, сек"
                    android:textColor="@color/text" />
                <EditText
                    android:id="@+id/editBatch"
                    style="@style/Input"
                    android:layout_width="110dp"
                    android:inputType="numberDecimal"
                    android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отрезок"
                    android:textColor="@color/text" />
                <EditText
                    android:id="@+id/editFrom"
                    style="@style/Input"
                    android:layout_width="78dp"
                    android:hint="0:00"
                    android:inputType="text" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="—"
                    android:textColor="@color/textDim" />
                <EditText
                    android:id="@+id/editTo"
                    style="@style/Input"
                    android:layout_width="78dp"
                    android:hint="конец"
                    android:inputType="text" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtBatchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBatch"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_burst"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Снять пачку кадров" />

            <ProgressBar
                android:id="@+id/progressBatch"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== Output settings panel ===== -->
        <LinearLayout
            android:id="@+id/cardSettings"
            style="@style/Card"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:paddingTop="0dp"
                android:text="Размер" />

            <RadioGroup
                android:id="@+id/radioSize"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/sizeOrig" style="@style/Segment" android:checked="true" android:text="Оригинал" />
                <RadioButton android:id="@+id/size720" style="@style/Segment" android:text="720p" />
                <RadioButton android:id="@+id/size1080" style="@style/Segment" android:text="1080p" />
                <RadioButton android:id="@+id/sizeCustom" style="@style/Segment" android:text="Свой" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/customSizeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:visibility="gone">
                <EditText
                    android:id="@+id/editW"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Ширина"
                    android:inputType="number"
                    android:text="1920" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="×"
                    android:textColor="@color/textDim" />
                <EditText
                    android:id="@+id/editH"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Высота"
                    android:inputType="number"
                    android:text="1080" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:text="Формат" />

            <RadioGroup
                android:id="@+id/radioFormat"
                style="@style/SegmentGroup">
                <RadioButton android:id="@+id/fmtJpg" style="@style/Segment" android:checked="true" android:text="JPG" />
                <RadioButton android:id="@+id/fmtPng" style="@style/Segment" android:text="PNG" />
                <RadioButton android:id="@+id/fmtWebp" style="@style/Segment" android:text="WebP" />
            </RadioGroup>

            <TextView
                android:id="@+id/txtQuality"
                style="@style/Label"
                android:text="Качество: 92" />

            <SeekBar
                android:id="@+id/seekQuality"
                style="@style/Slider"
                android:paddingTop="4dp"
                android:max="100"
                android:progress="92" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Captures section ===== -->
    <LinearLayout
        android:id="@+id/capHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="22dp"
        android:paddingBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Снятые кадры"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_count"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/txtTapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="нажми, чтобы открыть"
            android:textColor="@color/textDim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnSaveAll"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_gallery"
            android:text="В галерею" />
        <Button
            android:id="@+id/btnZip"
            style="@style/ToolBtn"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_archive"
            android:text="ZIP" />
        <Button
            android:id="@+id/btnClear"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_sweep"
            android:drawableTint="@color/danger"
            android:text="Очистить"
            android:textColor="@color/danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="30dp">
        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.6"
            android:src="@drawable/ic_photo"
            android:tint="@color/textDim" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:gravity="center"
            android:text="Пока пусто\nСними кадр кнопкой с камерой или пачку выше"
            android:textColor="@color/textDim"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
