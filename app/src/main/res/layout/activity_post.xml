<?xml version="1.0" encoding="utf-8"?>
<!-- «Пост в Telegram»: 6 photos + studio / models / hashtags -> album with the caption under the first photo -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.dave.framegrabber.ui.widget.SynthwaveView
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">
            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconBtn"
                android:contentDescription="Назад"
                android:src="@drawable/ic_arrow_back" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Пост в Telegram"
                    android:textColor="@color/text"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/txtChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/textDim"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnSetup"
                style="@style/IconBtn"
                android:contentDescription="Бот и канал"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- not set up yet -->
                <LinearLayout
                    android:id="@+id/cardSetup"
                    style="@style/Card"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Бот и канал ещё не настроены"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                    <Button
                        android:id="@+id/btnSetupNow"
                        style="@style/BtnPrimary"
                        android:layout_marginTop="10dp"
                        android:text="Настроить" />
                </LinearLayout>

                <!-- "already posted" warning (video or frames) -->
                <LinearLayout
                    android:id="@+id/cardDup"
                    style="@style/Card"
                    android:background="@drawable/bg_card_warn"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="⚠ Похоже, это уже было в канале"
                        android:textColor="@color/warn"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/txtDup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- photos -->
                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/CardTitle"
                        android:text="Фото" />
                    <TextView
                        android:id="@+id/txtPhotosHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Первое — обложка. Нажми на два фото, чтобы поменять их местами."
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                    <GridLayout
                        android:id="@+id/photoGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2" />
                </LinearLayout>

                <!-- studio + models -->
                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/CardTitle"
                        android:text="Студия и модели" />
                    <AutoCompleteTextView
                        android:id="@+id/editStudio"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:completionThreshold="1"
                        android:gravity="center_vertical"
                        android:hint="Студия"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords|textNoSuggestions" />
                    <com.dave.framegrabber.ui.widget.FlowLayout
                        android:id="@+id/modelChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <AutoCompleteTextView
                            android:id="@+id/editModel"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:completionThreshold="1"
                            android:gravity="center_vertical"
                            android:hint="Модель (Enter — добавить)"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords|textNoSuggestions" />
                        <Button
                            android:id="@+id/btnAddModel"
                            style="@style/BtnSecondary"
                            android:layout_width="52dp"
                            android:layout_marginStart="8dp"
                            android:text="＋"
                            android:textSize="20sp" />
                    </LinearLayout>
                    <!-- "this studio + models were posted on …" -->
                    <TextView
                        android:id="@+id/txtNamesHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:textColor="@color/warn"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- hashtags -->
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Хэштеги" />
                        <TextView
                            android:id="@+id/txtTagCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/editTagSearch"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:hint="🔍 Поиск по всем тегам или новый тег"
                        android:imeOptions="actionDone"
                        android:inputType="text|textNoSuggestions" />
                    <!-- filled by TagPicker: chosen, frequent, categories -->
                    <LinearLayout
                        android:id="@+id/tagArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        android:id="@+id/btnEditTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="Управление тегами и категориями ›"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- preview, like in the channel -->
                <LinearLayout style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Как будет в канале" />
                        <TextView
                            android:id="@+id/txtCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/textDim"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/bubble"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tg_bubble"
                        android:orientation="vertical"
                        android:padding="4dp">
                        <GridLayout
                            android:id="@+id/previewGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="3"
                            android:rowCount="2" />
                        <TextView
                            android:id="@+id/txtPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:padding="8dp"
                            android:textColor="#FFFFFFFF"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">
            <ProgressBar
                android:id="@+id/progressPost"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/stroke"
                android:progressTint="@color/accent"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtPostStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:textColor="@color/textDim"
                android:textSize="13sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnPublish"
                style="@style/BtnPrimary"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="#FFFFFFFF"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Опубликовать" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
