<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Съёмка»: preview, timeline, shutter. Recent videos while nothing is open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageCapture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Big preview (fills the free space) -->
    <FrameLayout
        android:id="@+id/previewCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_preview"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Video playback with sound -->
        <TextureView
            android:id="@+id/videoSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    
        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/phIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="?attr/logoMark" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="Выбери видео, чтобы начать"
                android:textColor="?attr/cTextDim"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnPickBig"
                style="@style/BtnPrimary"
                android:layout_width="wrap_content"
                android:minHeight="44dp"
                android:minWidth="200dp"
                android:maxLines="1"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Выбрать видео" />
        </LinearLayout>

        <!-- Mode chip: ● ВИДЕО / КАДР 3 из 20 -->
        <LinearLayout
            android:id="@+id/chipMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone">
            <View
                android:id="@+id/chipDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot" />
            <TextView
                android:id="@+id/chipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:letterSpacing="0.08"
                android:text="ВИДЕО"
                android:textColor="?attr/cAccent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTimeBadge"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="?attr/cText"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnPlay"
            style="@style/GlassBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:contentDescription="Воспроизвести"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <View
            android:id="@+id/flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FFFFFFFF" />
    </FrameLayout>

    <!-- ===== Recently opened videos (start screen) ===== -->
    <LinearLayout
        android:id="@+id/cardRecent"
        style="@style/Card"
        android:layout_marginTop="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_history"
                android:tint="?attr/cAccent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="Недавние видео"
                android:textColor="?attr/cText"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/recentRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ===== Timeline: filmstrip with the seek bar laid over it ===== -->
    <LinearLayout
        android:id="@+id/cardTimeline"
        style="@style/Card"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Таймлайн"
                android:textColor="?attr/cText"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="?attr/cTextDim"
                android:textSize="12sp" />
            <!-- 🔖 put a mark at the current moment -->
            <TextView
                android:id="@+id/btnMark"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:drawableStart="@drawable/ic_bookmark"
                android:drawablePadding="4dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@animator/press_scale"
                android:text="Метка"
                android:textColor="?attr/cText"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/timelineBox"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_filmstrip">

            <LinearLayout
                android:id="@+id/filmstrip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:progressDrawable="@drawable/seek_overlay"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb_bar"
                android:thumbOffset="3dp" />

            <!-- marks drawn over the timeline (touches pass through to the seek bar) -->
            <com.dave.framegrabber.ui.widget.MarksOverlay
                android:id="@+id/marksOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- marks: tap = go there, hold = remove; last chip takes a frame at every mark -->
        <HorizontalScrollView
            android:id="@+id/marksScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/marksRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- −1f  (📷)  +1f -->
    <LinearLayout
        android:id="@+id/captureControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPrev"
            style="@style/BtnSecondary"
            android:minWidth="72dp"
            android:text="−1f" />

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/btn_shutter"
            android:contentDescription="Снять кадр"
            android:elevation="4dp"
            android:src="@drawable/ic_camera"
            android:stateListAnimator="@animator/press_scale"
            android:tint="#FFFFFFFF" />

        <Button
            android:id="@+id/btnNext"
            style="@style/BtnSecondary"
            android:minWidth="72dp"
            android:text="+1f" />
    </LinearLayout>
</LinearLayout>
