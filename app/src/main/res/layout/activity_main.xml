<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen: app bar, three pages switched by the bottom bar, and a full-screen frame viewer.
  Pages: page_capture.xml (Съёмка), «Кадры» = the list below (header: frames_header.xml),
  page_clips.xml (Клипы), page_tools.xml (Инструменты).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Animated synthwave background (only with the «Цифровая волна» theme) -->
    <com.dave.framegrabber.ui.widget.SynthwaveView
        android:id="@+id/bgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== App bar ===== -->
        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:elevation="4dp"
                android:src="@drawable/logo_mark" />

            <LinearLayout
                android:id="@+id/titleBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:autoSizeMaxTextSize="19sp"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:text="Кадры из видео"
                    android:textColor="@color/text" />
                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="Видео не выбрано"
                    android:textColor="@color/textDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/IconBtn"
                android:layout_marginEnd="8dp"
                android:contentDescription="Общие настройки"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btnPick"
                style="@style/IconBtn"
                android:contentDescription="Выбрать видео"
                android:src="@drawable/ic_video_library" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/page_capture" />

            <!-- Page «Кадры»: grid of captured frames -->
            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingBottom="12dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <include layout="@layout/page_clips" />

            <include layout="@layout/page_tools" />
        </FrameLayout>

        <!-- Bottom bar -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_nav"
            android:elevation="8dp"
            android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/navCapture"
            style="@style/NavItem">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="32dp">
                <View android:id="@+id/navCapturePill" style="@style/NavPill" />
                <ImageView android:id="@+id/navCaptureIcon" style="@style/NavIcon" android:src="@drawable/ic_camera" />
            </FrameLayout>
            <TextView android:id="@+id/navCaptureLabel" style="@style/NavLabel" android:text="Съёмка" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navFrames"
            style="@style/NavItem">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="32dp">
                <View android:id="@+id/navFramesPill" style="@style/NavPill" />
                <ImageView android:id="@+id/navFramesIcon" style="@style/NavIcon" android:src="@drawable/ic_photo" />
                <TextView
                    android:id="@+id/navBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_count"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/navFramesLabel" style="@style/NavLabel" android:text="Кадры" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navClips"
            style="@style/NavItem">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="32dp">
                <View android:id="@+id/navClipsPill" style="@style/NavPill" />
                <ImageView android:id="@+id/navClipsIcon" style="@style/NavIcon" android:src="@drawable/ic_gif" />
            </FrameLayout>
            <TextView android:id="@+id/navClipsLabel" style="@style/NavLabel" android:text="Клипы" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navTools"
            style="@style/NavItem">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="32dp">
                <View android:id="@+id/navToolsPill" style="@style/NavPill" />
                <ImageView android:id="@+id/navToolsIcon" style="@style/NavIcon" android:src="@drawable/ic_build" />
            </FrameLayout>
            <TextView android:id="@+id/navToolsLabel" style="@style/NavLabel" android:text="Инструменты" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Full-screen viewer for a captured frame (pinch to zoom, swipe to flip) -->
    <FrameLayout
        android:id="@+id/viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_viewer"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <com.dave.framegrabber.ui.widget.ZoomImageView
            android:id="@+id/imgCapture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/viewerTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageButton
                android:id="@+id/btnCloseCap"
                style="@style/GlassBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_close" />
            <TextView
                android:id="@+id/txtViewerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
            <View
                android:layout_width="44dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCapPrev"
            style="@style/GlassBtn"
            android:layout_gravity="center_vertical|start"
            android:layout_margin="10dp"
            android:contentDescription="Предыдущий кадр"
            android:src="@drawable/ic_chev_left" />

        <ImageButton
            android:id="@+id/btnCapNext"
            style="@style/GlassBtn"
            android:layout_gravity="center_vertical|end"
            android:layout_margin="10dp"
            android:contentDescription="Следующий кадр"
            android:src="@drawable/ic_chev_right" />

        <LinearLayout
            android:id="@+id/viewerBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/txtViewerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/captureBar"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/actShare"
                    style="@style/ActionBtn"
                    android:drawableTop="@drawable/ic_share"
                    android:text="Отправить" />
                <Button
                    android:id="@+id/actSave"
                    style="@style/ActionBtn"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/ic_download"
                    android:text="Сохранить" />
                <Button
                    android:id="@+id/actJump"
                    style="@style/ActionBtn"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/ic_target"
                    android:text="Момент" />
                <Button
                    android:id="@+id/actText"
                    style="@style/ActionBtn"
                    android:layout_marginStart="6dp"
                    android:drawableTop="@drawable/ic_text"
                    android:text="Текст" />
                <Button
                    android:id="@+id/actDelete"
                    style="@style/ActionBtn"
                    android:layout_marginStart="6dp"
                    android:drawableTint="@color/danger"
                    android:drawableTop="@drawable/ic_delete"
                    android:text="Удалить" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
