<?xml version="1.0" encoding="utf-8"?>
<!-- Header of the «Кадры» page (the grid rows follow it in the list). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- ===== Captures section ===== -->
    <LinearLayout
        android:id="@+id/capHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Снятые кадры"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_count"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/txtTapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="нажми, чтобы открыть"
            android:textColor="@color/textDim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnSaveAll"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_gallery"
            android:text="Галерея" />
        <Button
            android:id="@+id/btnZip"
            style="@style/ToolBtn"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_archive"
            android:text="ZIP" />
        <Button
            android:id="@+id/btnClear"
            style="@style/ToolBtn"
            android:drawableStart="@drawable/ic_sweep"
            android:drawableTint="@color/danger"
            android:text="Очистить"
            android:textColor="@color/danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="30dp">
        <ImageView
            android:id="@+id/emptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.6"
            android:src="@drawable/ic_photo"
            android:tint="@color/textDim" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:gravity="center"
            android:text="Пока пусто\nСними кадр на вкладке «Съёмка»\nили пачку в «Инструментах»"
            android:textColor="@color/textDim"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
