<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Сайт»: pornolab.net inside the app (login stays, .torrent → Download, magnet → torrent app) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">
        <ImageButton
            android:id="@+id/btnSiteBack"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Назад"
            android:src="@drawable/ic_arrow_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">
            <TextView
                android:id="@+id/txtSiteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="pornolab.net"
                android:textColor="?attr/cText"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtSiteUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="?attr/cTextDim"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnSiteHome"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Главная"
            android:src="@drawable/ic_web" />
        <ImageButton
            android:id="@+id/btnSiteRefresh"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Обновить"
            android:src="@drawable/ic_history" />
        <ImageButton
            android:id="@+id/btnSiteMenu"
            style="@style/IconBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Ещё"
            android:src="@drawable/ic_more" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/siteProgress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="?attr/cAccent"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/siteHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
