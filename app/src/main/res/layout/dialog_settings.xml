<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/setIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/accent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Общие настройки"
            android:textColor="@color/text"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="ТЕМА"
        android:letterSpacing="0.1" />

    <!-- Classic (default) -->
    <LinearLayout
        android:id="@+id/optClassic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:stateListAnimator="@animator/press_scale">
        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/swatch_classic" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Классика"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тёмно-зелёная, спокойный фон"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/chkClassic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:tint="@color/accent" />
    </LinearLayout>

    <!-- Digital wave -->
    <LinearLayout
        android:id="@+id/optWave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:stateListAnimator="@animator/press_scale">
        <FrameLayout
            android:id="@+id/waveSwatch"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_thumb">
            <com.dave.framegrabber.SynthwaveView
                android:id="@+id/wavePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цифровая волна"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Закат, пальмы и зелёные треугольники в движении"
                android:textColor="@color/textDim"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/chkWave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:tint="@color/accent" />
    </LinearLayout>

    <!-- File names -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ИМЕНА ФАЙЛОВ" />
    <EditText
        android:id="@+id/editPattern"
        style="@style/Input"
        android:layout_width="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:inputType="text"
        android:paddingStart="12dp"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/txtPatternPreview"
        style="@style/SubHint"
        android:fontFamily="monospace"
        android:paddingTop="6dp" />
    <TextView
        style="@style/SubHint"
        android:paddingTop="4dp"
        android:text="{video} — имя видео, {time} — время кадра, {n} — номер, {date} — дата, {ms} — миллисекунды" />

    <!-- Save folder -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ПАПКА ДЛЯ СОХРАНЕНИЯ" />
    <LinearLayout
        android:id="@+id/rowFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder"
            android:tint="@color/accent" />
        <TextView
            android:id="@+id/txtFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textColor="@color/text"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Изменить"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- OCR languages -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ЯЗЫКИ РАСПОЗНАВАНИЯ ТЕКСТА" />
    <LinearLayout
        android:id="@+id/ocrLangs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btnDone"
        style="@style/BtnPrimary"
        android:layout_marginTop="20dp"
        android:text="Готово" />
</LinearLayout>
</ScrollView>
