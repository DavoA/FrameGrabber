<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/setIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings"
            android:tint="?attr/cAccent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Общие настройки"
            android:textColor="?attr/cText"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="ТЕМА"
        android:letterSpacing="0.1" />

    <!-- Classic (default) -->
    <LinearLayout
        android:id="@+id/optClassic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:stateListAnimator="@animator/press_scale">
        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/swatch_classic" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Классика"
                android:textColor="?attr/cText"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тёмно-зелёная, спокойный фон"
                android:textColor="?attr/cTextDim"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/chkClassic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:tint="?attr/cAccent" />
    </LinearLayout>

    <!-- Digital wave -->
    <LinearLayout
        android:id="@+id/optWave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:stateListAnimator="@animator/press_scale">
        <FrameLayout
            android:id="@+id/waveSwatch"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_thumb">
            <com.dave.framegrabber.ui.widget.SynthwaveView
                android:id="@+id/wavePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цифровая волна"
                android:textColor="?attr/cText"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Закат, пальмы и зелёные треугольники в движении"
                android:textColor="?attr/cTextDim"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/chkWave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:tint="?attr/cAccent" />
    </LinearLayout>

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="ЦВЕТ"
        android:letterSpacing="0.1" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/schemeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Frame quality (moved here from the main screen: set once) -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="КАЧЕСТВО КАДРОВ" />
    <TextView
        style="@style/Label"
        android:text="Размер" />

    <RadioGroup
        android:id="@+id/radioSize"
        style="@style/SegmentGroup">
        <RadioButton android:id="@+id/sizeOrig" style="@style/Segment" android:checked="true" android:text="Оригинал" />
        <RadioButton android:id="@+id/size720" style="@style/Segment" android:text="720p" />
        <RadioButton android:id="@+id/size1080" style="@style/Segment" android:text="1080p" />
        <RadioButton android:id="@+id/sizeCustom" style="@style/Segment" android:text="Свой" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/customSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/editW"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="Ширина"
            android:inputType="number"
            android:text="1920" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="×"
            android:textColor="?attr/cTextDim" />
        <EditText
            android:id="@+id/editH"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="Высота"
            android:inputType="number"
            android:text="1080" />
    </LinearLayout>

    <TextView
        style="@style/Label"
        android:text="Формат" />

    <RadioGroup
        android:id="@+id/radioFormat"
        style="@style/SegmentGroup">
        <RadioButton android:id="@+id/fmtJpg" style="@style/Segment" android:checked="true" android:text="JPG" />
        <RadioButton android:id="@+id/fmtPng" style="@style/Segment" android:text="PNG" />
        <RadioButton android:id="@+id/fmtWebp" style="@style/Segment" android:text="WebP" />
    </RadioGroup>

    <TextView
        android:id="@+id/txtQuality"
        style="@style/Label"
        android:text="Качество: 92" />

    <SeekBar
        android:id="@+id/seekQuality"
        style="@style/Slider"
        android:paddingTop="4dp"
        android:max="100"
        android:progress="92" />

    <TextView style="@style/Label" android:text="Умная съёмка" />
    <Switch
        android:id="@+id/swSharpest"
        style="@style/Toggle"
        android:checked="true"
        android:text="Самый резкий кадр рядом (±0,5 с)" />
    <TextView
        style="@style/SubHint"
        android:text="Проверяет соседние кадры и сохраняет наименее смазанный. Помогает при движении." />

    <!-- File names -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ИМЕНА ФАЙЛОВ" />
    <EditText
        android:id="@+id/editPattern"
        style="@style/Input"
        android:layout_width="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:inputType="text"
        android:paddingStart="12dp"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/txtPatternPreview"
        style="@style/SubHint"
        android:fontFamily="monospace"
        android:paddingTop="6dp" />
    <TextView
        style="@style/SubHint"
        android:paddingTop="4dp"
        android:text="{video} — имя видео, {time} — время кадра, {n} — номер, {date} — дата, {ms} — миллисекунды" />

    <!-- Save folder -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ПАПКА ДЛЯ СОХРАНЕНИЯ" />
    <LinearLayout
        android:id="@+id/rowFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder"
            android:tint="?attr/cAccent" />
        <TextView
            android:id="@+id/txtFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textColor="?attr/cText"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Изменить"
            android:textColor="?attr/cAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Telegram: bot + channel, hashtag library -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="TELEGRAM-КАНАЛ" />
    <LinearLayout
        android:id="@+id/rowTgSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_send"
            android:tint="?attr/cAccent" />
        <TextView
            android:id="@+id/txtTgSetup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textColor="?attr/cText"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Изменить"
            android:textColor="?attr/cAccent"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_text"
            android:tint="?attr/cAccent" />
        <TextView
            android:id="@+id/txtTags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textColor="?attr/cText"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Изменить"
            android:textColor="?attr/cAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ПЛЕЕР" />
<LinearLayout
        android:id="@+id/rowPlayerFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder"
            android:tint="?attr/cAccent" />
        <TextView
            android:id="@+id/txtPlayerFolders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textColor="?attr/cText"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Изменить"
            android:textColor="?attr/cAccent"
            android:textSize="13sp" />
    </LinearLayout>
    <Switch
        android:id="@+id/swPreviewKeep"
        style="@style/Toggle"
        android:layout_marginTop="8dp"
        android:text="Превью в библиотеке играет, пока не начнёшь другое" />
    <TextView
        style="@style/SubHint"
        android:text="Выключено: превью останавливается через 4 секунды после того, как отпустишь палец." />


    <!-- OCR languages -->
    <TextView
        style="@style/Label"
        android:paddingTop="20dp"
        android:letterSpacing="0.1"
        android:text="ЯЗЫКИ РАСПОЗНАВАНИЯ ТЕКСТА" />
    <LinearLayout
        android:id="@+id/ocrLangs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="ТОРРЕНТЫ (СТРАНИЦА РАЗДАЧИ → ⬇)"
        android:letterSpacing="0.1" />
    <LinearLayout
        android:id="@+id/torrentModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="ПАМЯТЬ"
        android:letterSpacing="0.1" />
    <Button
        android:id="@+id/btnStorage"
        style="@style/BtnSecondary"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Место на телефоне — что сколько занимает" />

    <TextView
        style="@style/Label"
        android:paddingTop="18dp"
        android:text="РЕЗЕРВНАЯ КОПИЯ"
        android:letterSpacing="0.1" />
    <TextView
        style="@style/SubHint"
        android:text="Хэштеги, имена, бот и ключи Telegram, папки и метки плеера, цвет, фото моделей — в один файл в Download/FrameGrabber. После переустановки восстанови из него." />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <Button
            android:id="@+id/btnBackupSave"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сохранить копию" />
        <Button
            android:id="@+id/btnBackupRestore"
            style="@style/BtnSecondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Восстановить" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDone"
        style="@style/BtnPrimary"
        android:layout_marginTop="20dp"
        android:text="Готово" />

    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:textColor="?attr/cTextDim"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
