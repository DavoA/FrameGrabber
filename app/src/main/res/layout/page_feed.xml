<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Канал»: your Telegram channel inside the app (logged in with your account) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageFeed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- login steps (filled in code) -->
    <ScrollView
        android:id="@+id/feedLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:id="@+id/feedLoginBox"
            style="@style/Card" />
    </ScrollView>

    <!-- the feed -->
    <LinearLayout
        android:id="@+id/feedMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtFeedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="?attr/cText"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/txtFeedSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="?attr/cTextDim"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnFeedFavs"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Любимые"
                android:src="@drawable/ic_heart_outline" />
            <ImageButton
                android:id="@+id/btnFeedSearch"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Поиск"
                android:src="@drawable/ic_search" />
            <ImageButton
                android:id="@+id/btnFeedRefresh"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Обновить"
                android:src="@drawable/ic_history" />
            <ImageButton
                android:id="@+id/btnFeedMenu"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Ещё"
                android:src="@drawable/ic_more" />
        </LinearLayout>
        <!-- search: words from captions, #hashtags, model / studio names -->
        <LinearLayout
            android:id="@+id/feedSearchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <EditText
                android:id="@+id/editFeedSearch"
                style="@style/Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:hint="Поиск по постам: слово, #тег, модель…"
                android:imeOptions="actionSearch"
                android:inputType="text" />
            <TextView
                android:id="@+id/txtFeedHits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:textColor="?attr/cTextDim"
                android:textSize="12sp" />
            <ImageButton
                android:id="@+id/btnFeedOlder"
                style="@style/IconBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Старее"
                android:src="@drawable/ic_arrow_up" />
            <ImageButton
                android:id="@+id/btnFeedNewer"
                style="@style/IconBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:rotation="180"
                android:contentDescription="Новее"
                android:src="@drawable/ic_arrow_up" />
            <ImageButton
                android:id="@+id/btnFeedSearchClose"
                style="@style/IconBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Закрыть поиск"
                android:src="@drawable/ic_close" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
        <ListView
            android:id="@+id/feedList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
            <!-- appears when you are far from the newest post: jump straight down -->
            <ImageButton
                android:id="@+id/btnFeedDown"
                style="@style/IconBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_fab"
                android:stateListAnimator="@null"
                android:elevation="6dp"
                android:rotation="180"
                android:tint="#FFFFFFFF"
                android:contentDescription="Вниз, к новым постам"
                android:src="@drawable/ic_arrow_up"
                android:visibility="gone" />
        </FrameLayout>
        <!-- a post being uploaded from the app: progress, what's left, cancel (filled in FeedTab) -->
        <LinearLayout
            android:id="@+id/feedUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
