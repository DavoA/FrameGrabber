<?xml version="1.0" encoding="utf-8"?>
<!-- Page «Канал»: your Telegram channel inside the app (logged in with your account) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageFeed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- login steps (filled in code) -->
    <ScrollView
        android:id="@+id/feedLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:id="@+id/feedLoginBox"
            style="@style/Card" />
    </ScrollView>

    <!-- the feed -->
    <LinearLayout
        android:id="@+id/feedMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtFeedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/txtFeedSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/textDim"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnFeedRefresh"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Обновить"
                android:src="@drawable/ic_history" />
            <ImageButton
                android:id="@+id/btnFeedMenu"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Ещё"
                android:src="@drawable/ic_more" />
        </LinearLayout>
        <ListView
            android:id="@+id/feedList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
